# 2T-Downloader Environment Configuration
# Copy this file to .env and modify as needed

# App Mode: "local" (default) or "production"
APP_MODE=local

# Download directory (absolute or relative to backend/)
# Local default: ./downloads
# Production default: ./temp_downloads
DOWNLOAD_DIR=

# Clean up files after serving them to browser
# Local default: false
# Production default: true
CLEANUP_AFTER_DOWNLOAD=false

# Maximum history items stored in database (0 = unlimited)
MAX_HISTORY_ITEMS=100
